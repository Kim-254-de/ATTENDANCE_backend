# ---------------------------------------------------------------------------
# Smart Attendance System — backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every variable here is validated at boot by src/config/env.ts — the process
# refuses to start if one is missing or malformed.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Base URL of the client app - used to build the link inside verification emails.
APP_PUBLIC_URL=http://localhost:5173

# --- Database --------------------------------------------------------------
# This service CONNECTS to an existing database. It does not create, migrate or
# own the schema. See docs/expected-schema.md for the tables it queries.
DATABASE_URL=postgresql://user:password@localhost:5432/attendance
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Set true when the database requires TLS (most managed/hosted Postgres).
DATABASE_SSL=false
# Only for a server presenting a self-signed certificate. Never true in production.
DATABASE_SSL_ALLOW_SELF_SIGNED=false

# --- Auth / tokens ---------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=smart-attendance-system

# Argon2id password hashing cost. Raise memoryCost on stronger hardware.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Hours before an email-verification token expires.
EMAIL_VERIFICATION_TTL_HOURS=24

# Minutes before a password reset link expires. Short on purpose - the link is a
# live key to the account.
PASSWORD_RESET_TTL_MINUTES=60

# --- Registration policy ---------------------------------------------------
# After ERP verification succeeds, should a new lecturer wait for an
# administrator to approve the account? (README §3.1 recommends yes.)
LECTURER_REQUIRES_ADMIN_APPROVAL=true

# --- ERP integration -------------------------------------------------------
# A lecturer whose staff number is not found in the ERP is REVOKED —
# no account is created. See src/integrations/erp/README.md.
ERP_BASE_URL=https://erp.example.ac.ke/api
ERP_STAFF_LOOKUP_PATH=/v1/staff/{staffNumber}
# Used when a lecturer allocates students to a unit by registration number.
ERP_STUDENT_LOOKUP_PATH=/v1/students/{registrationNumber}
# One of: bearer | api-key | basic | none
ERP_AUTH_SCHEME=bearer
ERP_API_KEY=replace-me
# Only used when ERP_AUTH_SCHEME=api-key
ERP_API_KEY_HEADER=X-API-Key
# Only used when ERP_AUTH_SCHEME=basic
ERP_BASIC_USERNAME=
ERP_BASIC_PASSWORD=
ERP_TIMEOUT_MS=5000
ERP_MAX_RETRIES=2
# Cache successful ERP lookups for this long to reduce load (0 disables).
ERP_CACHE_TTL_SECONDS=300
# When true, the ERP's returned name/email must match what the lecturer typed.
ERP_ENFORCE_IDENTITY_MATCH=true

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
REGISTER_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=10
# Each request sends an email, so this is deliberately tight.
PASSWORD_RESET_RATE_LIMIT_MAX=5
# Account lockout: this many consecutive wrong passwords locks the account for the given minutes.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Local Postgres container (docker-compose.yml) ---
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=attendance

# --- Attendance QR codes ---------------------------------------------------
# The projected QR changes every QR_ROTATION_SECONDS so a photographed code
# stops working. Nothing is stored per rotation - the code is derived from the
# session secret and the current time window.
QR_ROTATION_SECONDS=60
# Older windows still accepted, covering the delay between opening the camera
# and the scan reaching the server. 1 => a code is usable for 60-120s.
# Raising this widens the window in which a shared screenshot still works.
QR_ACCEPT_PREVIOUS_WINDOWS=1
# Pixel width of the rendered PNG.
QR_IMAGE_SIZE=512
