# ---------------------------------------------------------------------------
# Smart Attendance System — backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every variable here is validated at boot by src/config/env.ts — the process
# refuses to start if one is missing or malformed.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Base URL of the client app - used to build the link inside verification emails.
APP_PUBLIC_URL=http://localhost:5173

# --- Database --------------------------------------------------------------
# This service CONNECTS to an existing database. It does not create, migrate or
# own the schema. See docs/expected-schema.md for the tables it queries.
DATABASE_URL=postgresql://user:password@localhost:5432/attendance
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Set true when the database requires TLS (most managed/hosted Postgres).
DATABASE_SSL=false
# Only for a server presenting a self-signed certificate. Never true in production.
DATABASE_SSL_ALLOW_SELF_SIGNED=false

# --- Auth / tokens ---------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=smart-attendance-system

# Argon2id password hashing cost. Raise memoryCost on stronger hardware.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Hours before an email-verification token expires.
EMAIL_VERIFICATION_TTL_HOURS=24

# --- Email delivery (Resend) ----------------------------------------------
# Leave RESEND_API_KEY empty in development: mail is then logged instead of
# sent, and the verification / reset links are printed in the API log, which is
# how you follow those flows locally. In production an empty key is an error.
# Use the same key as SMARTTT so both services send from one verified domain.
RESEND_API_KEY=
# The sender. Its domain must be verified in Resend, or Resend refuses the send.
# onboarding@resend.dev works for testing but only delivers to your own address.
EMAIL_FROM=Smart Attendance <onboarding@resend.dev>

# Minutes before a password reset link expires. Short on purpose - the link is a
# live key to the account.
PASSWORD_RESET_TTL_MINUTES=60

# --- ERP integration -------------------------------------------------------
# A lecturer whose staff number is not found in the ERP is REVOKED —
# no account is created. See src/integrations/erp/README.md.
ERP_BASE_URL=https://erp.example.ac.ke/api
ERP_STAFF_LOOKUP_PATH=/v1/staff/{staffNumber}
# Used when a lecturer allocates students to a unit by registration number.
ERP_STUDENT_LOOKUP_PATH=/v1/students/{registrationNumber}
# Used when a lecturer adds a unit: the code is checked against the issued
# timetable, which supplies the real name/schedule and who's assigned to teach it.
ERP_COURSE_LOOKUP_PATH=/v1/courses/{code}
# Used to sync a unit's roster: who the registrar's records enrol in the course.
ERP_COURSE_ENROLLMENTS_PATH=/v1/courses/{code}/students
# One of: bearer | api-key | basic | none
ERP_AUTH_SCHEME=bearer
ERP_API_KEY=replace-me
# Only used when ERP_AUTH_SCHEME=api-key
ERP_API_KEY_HEADER=X-API-Key
# Only used when ERP_AUTH_SCHEME=basic
ERP_BASIC_USERNAME=
ERP_BASIC_PASSWORD=
ERP_TIMEOUT_MS=5000
ERP_MAX_RETRIES=2

# --- SMARTTT (university timetable) ---
# Where a lecturer's units and each unit's registered-student count come from.
# Leave SMARTTT_BASE_URL empty to switch the sync off.
# SMARTTT_API_KEY must equal ATTENDANCE_API_KEY in SMARTTT's environment.
SMARTTT_BASE_URL=
SMARTTT_API_KEY=
SMARTTT_LECTURER_UNITS_PATH=/api/v1/integrations/attendance/lecturer-units/
# Student registration checks the registration number here (falls back to the ERP when SMARTTT is off).
SMARTTT_STUDENT_LOOKUP_PATH=/api/v1/integrations/attendance/students/
# Lecturer registration checks the staff number here (falls back to the ERP when SMARTTT is off or doesn't list it).
SMARTTT_STAFF_LOOKUP_PATH=/api/v1/integrations/attendance/staff/
# A student's units page lists the classes they are registered for here.
SMARTTT_STUDENT_UNITS_PATH=/api/v1/integrations/attendance/student-units/
SMARTTT_TIMEOUT_MS=8000
SMARTTT_SYNC_INTERVAL_SECONDS=60
# Cache successful ERP lookups for this long to reduce load (0 disables).
ERP_CACHE_TTL_SECONDS=300

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
REGISTER_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=10
# Each request sends an email, so this is deliberately tight.
PASSWORD_RESET_RATE_LIMIT_MAX=5
# Check-in (POST /attendance/check-in, /sessions/scan) is exempt from the
# per-IP limit above: a whole class shares the campus Wi-Fi's public IP.
# Instead it is limited per signed-in student, with a high per-IP backstop.
CHECKIN_RATE_LIMIT_WINDOW_MS=300000
CHECKIN_RATE_LIMIT_PER_STUDENT=20
CHECKIN_RATE_LIMIT_PER_IP=3000
# Account lockout: this many consecutive wrong passwords locks the account for the given minutes.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Local Postgres container (docker-compose.yml) ---
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=attendance

# --- Attendance QR codes ---------------------------------------------------
# The zone timetable slots are written in. The server's own clock is usually UTC
# (Render, Docker), so "is this class on now?" is answered in this zone.
CAMPUS_TIMEZONE=Africa/Nairobi

# The projected QR changes every QR_ROTATION_SECONDS so a photographed code
# stops working. Nothing is stored per rotation - the code is derived from the
# session secret and the current time window.
QR_ROTATION_SECONDS=45
# Older windows still accepted, covering the delay between opening the camera
# and the scan reaching the server. 1 => a code is usable for 60-120s.
# Raising this widens the window in which a shared screenshot still works.
QR_ACCEPT_PREVIOUS_WINDOWS=1
# Pixel width of the rendered PNG.
QR_IMAGE_SIZE=512

# --- Student ID card check-in ---------------------------------------------
# The shared key every card terminal sends as X-API-Key. Leave empty and card
# check-in is refused outright, which is the right default: an open terminal
# endpoint would let anyone mark a hall present.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CARD_TERMINAL_API_KEY=
# Keys the HMAC that card UIDs are stored under. Required whenever
# CARD_TERMINAL_API_KEY is set. A card UID is only 32-56 bits, so a plain hash
# of it could be enumerated from a database dump and written onto blank cards.
# Changing this invalidates every enrolled card — which is the recovery path if
# student_cards ever leaks.
CARD_UID_SECRET=

# --- Geofenced check-in ----------------------------------------------------
# A check-in is accepted when (distance from the room's centre - reported
# accuracy) <= GEOFENCE_RADIUS_METRES. Readings vaguer than the student limit
# are refused outright; a lecturer-device centre vaguer than the anchor limit
# cannot be used. Readings older than GEOFENCE_MAX_FIX_AGE_SECONDS are stale.
GEOFENCE_RADIUS_METRES=20
GEOFENCE_MAX_STUDENT_ACCURACY_METRES=50
GEOFENCE_MAX_ANCHOR_ACCURACY_METRES=30
GEOFENCE_MAX_FIX_AGE_SECONDS=60
